# ---------------------------------------------------------------------------
# Single source of truth for topology constants.
# Every harness, DAG and service reads these, so the README's numbers and the
# running system cannot drift apart.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=rtdp

# --- Kafka ------------------------------------------------------------------
KAFKA_CLUSTER_ID=rtdp-kraft-cluster-0001
KAFKA_BOOTSTRAP_INTERNAL=kafka1:9092,kafka2:9092,kafka3:9092
KAFKA_BOOTSTRAP_EXTERNAL=localhost:19092,localhost:19093,localhost:19094
TOPIC_TRIPS=trips.raw
TOPIC_DLQ=trips.dlq
TOPIC_PARTITIONS=6
TOPIC_REPLICATION=3
TOPIC_MIN_ISR=2
CONSUMER_GROUP=rtdp-spark-trips

# --- Cassandra --------------------------------------------------------------
CASSANDRA_HOSTS=cassandra1,cassandra2,cassandra3
CASSANDRA_KEYSPACE=rtdp
CASSANDRA_REPLICATION_FACTOR=3
CASSANDRA_WRITE_CONSISTENCY=QUORUM
CASSANDRA_READ_CONSISTENCY=QUORUM

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=rtdp
POSTGRES_PASSWORD=rtdp
POSTGRES_DB=rtdp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Spark ------------------------------------------------------------------
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_EXECUTOR_CORES=3
SPARK_EXECUTOR_MEMORY=1g
SPARK_WORKER_COUNT=2
SPARK_CHECKPOINT_DIR=/opt/checkpoints/trips
SPARK_MAX_OFFSETS_PER_TRIGGER=200000

# --- Reliability layer ------------------------------------------------------
# Section 6: 1s -> 2s -> 4s. Comma-separated so the A/B harness can override
# it with an empty string to disable backoff entirely.
RETRY_BACKOFF_SCHEDULE_MS=1000,2000,4000
RETRY_MAX_ATTEMPTS=4
RETRY_JITTER_RATIO=0.1
# Watermark / allowed lateness (Section 6, event-time handling)
WATERMARK_DELAY=2 minutes
LATE_EVENT_POLICY=dlq

# --- Producer ---------------------------------------------------------------
PRODUCER_TARGET_RATE=1000
PRODUCER_DURATION_SEC=60
PRODUCER_FAULT_RATE=0.0
